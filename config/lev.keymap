#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /*
             * Keymap follows the legends in the supplied photo.
             * Unlabelled thumb keys are assigned SPACE (left) and ENTER (right)
             * as practical defaults; encoder pushes are MUTE.
             */
            bindings = <
                /* number row */
                &kp ESC   &kp GRAVE &kp N2 &kp N3 &kp N4 &kp N5
                &kp N6    &kp N7    &kp N8 &kp N9 &kp N0 &kp EQUAL

                /* QWERTY row */
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T
                &kp Y     &kp U &kp I &kp O &kp P &kp MINUS

                /* home row + encoder pushes */
                &kp TILDE &kp A &kp S &kp D &kp F &kp G &kp C_MUTE
                &kp C_MUTE &kp H &kp J &kp K &kp L &kp SEMI &kp SQT

                /* lower alpha row + upper thumb keys */
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp SPACE
                &kp ENTER &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BSLH

                /* bottom / thumb row */
                &mo 1 &kp LCTRL &kp LALT &kp LGUI &kp SPACE
                &kp ENTER &kp LEFT &kp RIGHT &kp LBKT &kp RBKT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            bindings = <
                /* Keep the photographed number row useful as F-keys on Layer. */
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5
                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans

                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans

                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans

                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans

                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
